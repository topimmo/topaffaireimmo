# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration (Choose MongoDB or Redis for OTP storage)
MONGODB_URI=mongodb://localhost:27017/topaffaireimmo

# Redis Configuration (Optional - for OTP storage, recommended for production)
# If both MongoDB and Redis are configured, Redis will be used for OTP storage
REDIS_URL=redis://localhost:6379

# Vonage (Nexmo) Configuration
# Get your API credentials from: https://dashboard.nexmo.com/
VONAGE_API_KEY=your_vonage_api_key_here
VONAGE_API_SECRET=your_vonage_api_secret_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# OTP Configuration
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=60
RATE_LIMIT_MAX_REQUESTS=3

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Phone Validation (Morocco)
ALLOWED_COUNTRY_CODE=+212
