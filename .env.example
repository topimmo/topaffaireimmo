# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your Supabase anonymous/public key (safe to use in client-side code)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Production Domain (REQUIRED for production)
# Used for password reset emails and canonical URLs
# Change this to your production domain
# Examples: https://topaffaireimmo.com or https://www.topaffaireimmo.com
VITE_PRODUCTION_DOMAIN=https://topaffaireimmo.com

# Instructions:
# 1. Copy this file to .env
# 2. Replace YOUR_PROJECT_ID with your actual Supabase project ID
# 3. Replace your_supabase_anon_key_here with your actual anonymous key
# 4. Set VITE_PRODUCTION_DOMAIN to your production domain (CRITICAL for password reset!)
# 5. Never commit the .env file to version control

# Email Configuration (Hostinger SMTP)
# ⚠️ IMPORTANT: Email settings are NOT configured here
# Configure SMTP in Supabase Dashboard → Settings → Auth → SMTP Settings
# See /docs/SUPABASE_DASHBOARD_EMAIL_CONFIG.md for detailed setup instructions
# See /docs/EMAIL_CONFIGURATION_INDEX.md for quick start guide

# Make.com Webhook URL (for Facebook auto-posting)
# This is used by the Supabase Edge Function to send approved listings to Make
# Get this URL from your Make scenario webhook trigger
# Example: https://hook.eu1.make.com/xxxxxxxxxxxxxxxxxx
# Note: This should be configured in Supabase Edge Function secrets, not here
# Add it via: supabase secrets set MAKE_WEBHOOK_URL=your_webhook_url
MAKE_WEBHOOK_URL=

