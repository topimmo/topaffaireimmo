# Supabase Configuration
# Get these values from your Supabase project settings:
# https://app.supabase.com/project/YOUR_PROJECT_ID/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Your Supabase anonymous/public key (safe to use in client-side code)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sentry Configuration (for error monitoring)
# Get your DSN from: https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
# This is safe to use in client-side code (it's a public DSN)
VITE_SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/YOUR_PROJECT_ID

# Sentry Build Configuration (for uploading source maps - CI/CD only)
# These should ONLY be set in your CI/CD environment (GitHub Actions, Vercel, etc.)
# DO NOT commit these values or put them in .env files
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=topaffaireimmo
# SENTRY_PROJECT=topaffaireimmo-web

# Site URL (CRITICAL for auth redirects in production)
# This is the primary domain where auth email links should redirect
# In production, set this to your production domain
# Examples: https://www.topaffaireimmo.com
# If not set, falls back to window.location.origin, then https://www.topaffaireimmo.com
VITE_SITE_URL=https://www.topaffaireimmo.com

# Production Domain (REQUIRED for production)
# Used for password reset emails and canonical URLs
# Change this to your production domain
# Examples: https://topaffaireimmo.com or https://www.topaffaireimmo.com
VITE_PRODUCTION_DOMAIN=https://topaffaireimmo.com

# ⚠️ IMPORTANT: After setting VITE_SITE_URL, you must also configure Supabase:
# 1. Go to Supabase Dashboard → Authentication → URL Configuration
# 2. Set "Site URL" to: https://www.topaffaireimmo.com
# 3. Add these Redirect URLs (allowed):
#    Production:
#      - https://www.topaffaireimmo.com/**
#      - https://topaffaireimmo.com/**
#      - https://www.topaffaireimmo.com/auth/callback
#      - https://topaffaireimmo.com/auth/callback
#      - https://www.topaffaireimmo.com/reset-password
#      - https://topaffaireimmo.com/reset-password
#    Development:
#      - http://localhost:5173/**
#      - http://localhost:5173/auth/callback
#      - http://localhost:5173/reset-password
#      - http://127.0.0.1:5173/**
#    Vercel Previews (if applicable):
#      - https://*.vercel.app/**
# This ensures email confirmation and password reset links work correctly on all domains
# ⚠️ Without /reset-password in redirect URLs, password reset will fail with "otp_expired" error

# Instructions:
# 1. Copy this file to .env
# 2. Replace YOUR_PROJECT_ID with your actual Supabase project ID
# 3. Replace your_supabase_anon_key_here with your actual anonymous key
# 4. Set VITE_PRODUCTION_DOMAIN to your production domain (CRITICAL for password reset!)
# 5. Never commit the .env file to version control

# Email Configuration (Hostinger SMTP)
# ⚠️ IMPORTANT: Email settings are NOT configured here
# Configure SMTP in Supabase Dashboard → Settings → Auth → SMTP Settings
# See /docs/SUPABASE_DASHBOARD_EMAIL_CONFIG.md for detailed setup instructions
# See /docs/EMAIL_CONFIGURATION_INDEX.md for quick start guide

# Make.com Webhook URL (for Facebook auto-posting)
# This is used by the Supabase Edge Function to send approved listings to Make
# Get this URL from your Make scenario webhook trigger
# Example: https://hook.eu1.make.com/xxxxxxxxxxxxxxxxxx
# Note: This should be configured in Supabase Edge Function secrets, not here
# Add it via: supabase secrets set MAKE_WEBHOOK_URL=your_webhook_url
MAKE_WEBHOOK_URL=

# =====================================================
# SAMPLE LISTINGS SEED SCRIPT CONFIGURATION
# =====================================================
# These variables are used by the seed-sample-listings script
# to generate demo property listings for development/testing

# Supabase URL - Can use either SUPABASE_URL or VITE_SUPABASE_URL
# The script will check both and use whichever is set
# In CI/CD (GitHub Actions), use VITE_SUPABASE_URL to match other workflows
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Supabase Service Role Key (KEEP SECRET - Server-side only!)
# Get this from: Supabase Dashboard → Settings → API → service_role key
# ⚠️  WARNING: This key bypasses RLS - never expose it in client-side code
# Only use for server-side scripts and CI/CD
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Pexels API Key (for fetching stock property images)
# Get a free API key from: https://www.pexels.com/api/
# Used to fetch realistic property images for sample listings
# If not provided, script will use placeholder images
PEXELS_API_KEY=your_pexels_api_key_here

# Number of sample listings to generate (default: 50)
# Adjust based on your needs (recommended: 30-100 for testing)
LISTINGS_COUNT=50

# Force seed flag (REQUIRED for safety)
# The seed script requires this to be set to "true" to run
# This prevents accidental seeding in production environments
# Usage: FORCE_SEED=true npm run seed:sample-listings
# ⚠️  DO NOT set to true by default - only use when explicitly seeding
# FORCE_SEED=false

# =====================================================
# WEB PUSH NOTIFICATIONS CONFIGURATION
# =====================================================
# VAPID keys for Web Push Notifications
# Generate using: npm run generate:vapid-keys (or npx tsx scripts/generate-vapid-keys.ts)
# The public key is used in the frontend to subscribe users
# The private key is used in the backend (Supabase Edge Function) to send notifications

# VAPID Public Key (safe to use in client-side code)
# Add this to your .env file and Vercel environment variables
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# VAPID Private Key (KEEP SECRET - Backend only!)
# DO NOT add this to frontend environment variables
# Add this to Supabase Edge Function secrets using:
# supabase secrets set VAPID_PRIVATE_KEY="your_vapid_private_key_here"
# supabase secrets set VAPID_PUBLIC_KEY="your_vapid_public_key_here"
# supabase secrets set VAPID_SUBJECT="mailto:contact@topaffaireimmo.com"
# Note: The private key should NEVER be in this file or committed to git

# =====================================================
# WHATSAPP CONFIGURATION
# =====================================================
# WhatsApp business contact number (format: country code + number, no + or -)
# Used in AdSense fallback CTA and contact buttons
# Example for Morocco: 212664352280
VITE_WHATSAPP_NUMBER=212664352280

# =====================================================
# SMS OTP AUTHENTICATION CONFIGURATION (VONAGE VERIFY API)
# =====================================================
# Vonage Verify API Configuration (for OTP authentication)
# Get your API credentials from: https://dashboard.nexmo.com/
# These are SERVER-SIDE ONLY - used in API routes (/api/auth/otp/*)
# 
# IMPORTANT: This uses Vonage Verify API (NOT SMS API)
# Vonage generates and manages the OTP codes automatically

# Vonage API Key (from Vonage Dashboard)
VONAGE_API_KEY=your_vonage_api_key_here

# Vonage API Secret (from Vonage Dashboard)
VONAGE_API_SECRET=your_vonage_api_secret_here

# Vonage sender name/brand (what appears in verification SMS)
# Used as the "brand" parameter in Vonage Verify API
# Max 18 alphanumeric characters
# Example: "TopAffaire" or "TopAffaireImmo"
VONAGE_FROM=TopAffaire

# JWT Secret for signing authentication tokens
# CRITICAL: Generate a strong random secret (at least 32 characters)
# Use: openssl rand -base64 32
# This is used to sign JWT tokens after successful OTP verification
JWT_SECRET=your_strong_random_jwt_secret_here

# Note: SUPABASE_SERVICE_ROLE_KEY (already defined above) is also used for OTP storage
# The OTP system stores verification attempts in Supabase otp_attempts table for rate limiting


