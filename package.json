{
  "name": "starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=18 <=20",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:sitemaps && npm run generate:og-images && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 500",
    "preview": "vite preview",
    "types:supabase": "npx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/supabase.ts",
    "generate:sitemaps": "npx tsx scripts/generate-sitemaps.ts",
    "generate:og-images": "npx tsx scripts/generate-og-images.ts",
    "generate:vapid-keys": "npx tsx scripts/generate-vapid-keys.ts",
    "seed:sample-listings": "npx tsx scripts/seed-sample-listings.ts",
    "generate:moroccan-listings": "npx tsx scripts/generate-moroccan-listings.ts",
    "debug:listings": "npx tsx scripts/debug-listings.ts",
    "fix:listings": "npx tsx scripts/quick-fix-listings.ts",
    "check:migrations": "npx tsx scripts/check-migrations.ts",
    "diagnose:supabase": "npx tsx scripts/diagnose-supabase.ts",
    "diagnose:production": "npx tsx scripts/diagnose-production.ts",
    "diagnose:frontend": "node scripts/diagnose-frontend.cjs",
    "verify:ga4": "node scripts/verify-ga4.js",
    "verify:auth-fix": "node scripts/verify-auth-fix.js",
    "setup:storage-buckets": "node scripts/setup-storage-buckets.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.45.6",
    "@types/dompurify": "^3.0.5",
    "@vonage/server-sdk": "^3.26.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dompurify": "^3.3.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.18.0",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.12.36",
    "lucide-react": "^0.394.0",
    "next-themes": "^0.4.6",
    "react": "^18.2.0",
    "react-day-picker": "^9.12.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.68.0",
    "react-resizable-panels": "^2.1.9",
    "react-router": "^6.23.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
