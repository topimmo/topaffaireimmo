.github/agents/
!.github/workflows/

# Tempo
.tempo/

**/tempobook/**
.env
.env.*
!.env.example

# Never commit env files in migrations
supabase/migrations/env
supabase/migrations/env.*
supabase/migrations/.env
supabase/migrations/.env.*

# Supabase temp files and local config
.supabase/
supabase/.temp/
supabase/config.toml

# Compiled JavaScript files from TypeScript
src/**/*.js
!src/**/*.config.js

# PWA service worker files (auto-generated by vite-plugin-pwa)
dev-dist
dist/sw.js
dist/workbox-*.js
dist/manifest.webmanifest

# Test files
test-*.html

# Playwright test results
test-results/
playwright-report/
playwright/.cache/
